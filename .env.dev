# Database Configuration
# Use localhost when running locally, use 'db' when running in Docker
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/todo_service

# Security
SECRET_KEY=your_secret_key_change_this_in_production

# Admin User (for initial seeding)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123

# Application Settings
DEBUG=true

# Logging Configuration
LOG_LEVEL=DEBUG

#CORS Configuration
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=true

#Security headers
ENABLE_HSTS=false

# JWT Token Expiration (optional - defaults shown)
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
