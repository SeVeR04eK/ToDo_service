# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/todo_service

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=your_production_secret_key_minimum_32_characters

# Admin User (for initial seeding)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=your_secure_admin_password

# Application Settings
DEBUG=false

# Logging Configuration
LOG_LEVEL=INFO

#CORS Configuration
CORS_ALLOW_ORIGINS=["https://yourdomain.com"]
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type"]
CORS_ALLOW_CREDENTIALS=true

#Security headers
ENABLE_HSTS=true

#Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=1.0
REDIS_SOCKET_CONNECT_TIMEOUT=1.0

# Rate Limit Configuration

# Auth endpoints
RATE_LIMIT_AUTH_LOGIN_LIMIT=5
RATE_LIMIT_AUTH_LOGIN_WINDOW=60

RATE_LIMIT_AUTH_REFRESH_LIMIT=30
RATE_LIMIT_AUTH_REFRESH_WINDOW=60

RATE_LIMIT_AUTH_LOGOUT_ALL_LIMIT=5
RATE_LIMIT_AUTH_LOGOUT_ALL_WINDOW=60

# User endpoints
RATE_LIMIT_USER_GET_LIMIT=60
RATE_LIMIT_USER_GET_WINDOW=60

RATE_LIMIT_USER_PATCH_LIMIT=10
RATE_LIMIT_USER_PATCH_WINDOW=60

RATE_LIMIT_USER_DELETE_LIMIT=3
RATE_LIMIT_USER_DELETE_WINDOW=3600

# Task endpoints
RATE_LIMIT_TASKS_READ_LIMIT=120
RATE_LIMIT_TASKS_READ_WINDOW=60

RATE_LIMIT_TASKS_CREATE_LIMIT=30
RATE_LIMIT_TASKS_CREATE_WINDOW=60

RATE_LIMIT_TASKS_UPDATE_LIMIT=60
RATE_LIMIT_TASKS_UPDATE_WINDOW=60

RATE_LIMIT_TASKS_DELETE_LIMIT=60
RATE_LIMIT_TASKS_DELETE_WINDOW=60

# Admin endpoints
RATE_LIMIT_ADMIN_USERS_LIST_LIMIT=30
RATE_LIMIT_ADMIN_USERS_LIST_WINDOW=60

RATE_LIMIT_ADMIN_USERS_GET_LIMIT=60
RATE_LIMIT_ADMIN_USERS_GET_WINDOW=60

RATE_LIMIT_ADMIN_USERS_PATCH_LIMIT=20
RATE_LIMIT_ADMIN_USERS_PATCH_WINDOW=60

RATE_LIMIT_ADMIN_USERS_DELETE_LIMIT=10
RATE_LIMIT_ADMIN_USERS_DELETE_WINDOW=60

RATE_LIMIT_ADMIN_USER_TASKS_LIST_LIMIT=60
RATE_LIMIT_ADMIN_USER_TASKS_LIST_WINDOW=60

RATE_LIMIT_ADMIN_USER_TASK_GET_LIMIT=60
RATE_LIMIT_ADMIN_USER_TASK_GET_WINDOW=60

RATE_LIMIT_ADMIN_USER_TASK_UPDATE_LIMIT=30
RATE_LIMIT_ADMIN_USER_TASK_UPDATE_WINDOW=60

RATE_LIMIT_ADMIN_USER_TASK_DELETE_LIMIT=20
RATE_LIMIT_ADMIN_USER_TASK_DELETE_WINDOW=60

RATE_LIMIT_ADMIN_ROLE_CREATE_LIMIT=10
RATE_LIMIT_ADMIN_ROLE_CREATE_WINDOW=60

RATE_LIMIT_ADMIN_ROLES_LIST_LIMIT=60
RATE_LIMIT_ADMIN_ROLES_LIST_WINDOW=60

# JWT Token Expiration (optional - defaults shown)
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# FAMILY_TOKEN_EXPIRE_DAYS=30
